# Node
node_modules/
web/dist/

# Python
__pycache__/
*.pyc
.venv/
venv/
.ipynb_checkpoints/
.pytest_cache/

# Test scratch: tests/test_pipeline.py makes tmp* folders in the repository root and removes them
/tmp*/

# Display basemap for the viewer, generated by `npm --prefix web run basemap` from open sources.
# Not committed (16 MB of binaries); .github/workflows/deploy-viewer.yml rebuilds it. The small
# provenance records imagery.json and landcover.json ARE committed (the viewer does not read them).
# terrain_hi.json is ignored with its .bin: the viewer uses it to decide whether the 30 m terrain exists.
web/public/data/terrain_hi.bin
web/public/data/terrain_hi.json
web/public/data/imagery.jpg
web/public/data/landcover.png

# Building tiles for the viewer, generated by `npm --prefix web run buildings` (OSM, Microsoft footprints,
# Google 2.5D heights); the deploy workflow rebuilds them. The provenance record buildings.json IS committed.
# web/.cache holds that tool's downloads (about 300 MB) so a rebuild does not fetch them again.
web/public/data/buildings/
web/.cache/

# SFINCS model folders for flood run 1 (docs/model_design_flood_run1.md): rebuilt by the pipeline
# scripts that write them; their NetCDF outputs are large. Results that matter are written to docs/.
models/

# Console logs rewritten on every pipeline run (data/logs/*fetch*.log and model-run logs stay tracked)
data/logs/run_all_*.log

# Local Claude Code and editor settings (.claude/launch.json is shared and stays tracked)
.claude/settings.local.json
.vscode/
.idea/

# Env / OS
.env
.env.*
.DS_Store
Thumbs.db
desktop.ini
# untested model output for checking displays in the dev server only (pipeline/flood_water_viewer.py --test)
web/dev-data/
